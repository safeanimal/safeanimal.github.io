---
import { profile } from '@data/profile';
import Button from '@components/UI/Button.astro';
import SocialLinks from '@components/UI/SocialLinks.astro';
---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      {profile.avatar && (
        <div class="hero-image-wrapper">
          <div class="hero-image">
            <img src={profile.avatar} alt={profile.name} />
          </div>
        </div>
      )}
      
      <div class="hero-text">
        <h1 class="hero-title">{profile.name}</h1>
        <p class="hero-subtitle">{profile.title}</p>
        <p class="hero-institution">
          {profile.department} &bull; {profile.institution}
        </p>
        
        <div class="hero-interests">
          {profile.researchInterests.map((interest) => (
            <span class="interest-tag">{interest}</span>
          ))}
        </div>

        <p class="hero-bio">{profile.bio}</p>

        <div class="hero-actions">
          <Button href={`mailto:${profile.email}`} variant="primary">
            Contact Me
          </Button>
          {profile.cv && (
            <Button href={profile.cv} variant="outline" external={true}>
              Download CV
            </Button>
          )}
        </div>

        <div class="hero-social">
          <SocialLinks />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--spacing-20) 0;
    min-height: 90vh; /* Occupy most of the viewport height */
    display: flex;
    align-items: center;
    background: radial-gradient(circle at top right, var(--color-primary-light), transparent 40%),
                radial-gradient(circle at bottom left, var(--color-surface-variant), transparent 40%);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-4);
    width: 100%;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-8);
  }

  .hero-image-wrapper {
    position: relative;
    margin-bottom: var(--spacing-4);
  }

  .hero-image {
    width: 180px;
    height: 180px;
    border-radius: var(--radius-full);
    overflow: hidden;
    border: 4px solid var(--color-surface);
    box-shadow: var(--shadow-xl);
    transition: transform var(--transition-slow);
  }
  
  .hero-image:hover {
    transform: scale(1.05);
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-4);
    max-width: 800px;
  }

  .hero-title {
    font-size: var(--font-size-5xl);
    font-family: var(--font-serif);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: var(--font-size-xl);
    color: var(--color-primary);
    font-weight: 600;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: var(--font-size-sm);
  }

  .hero-institution {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin: 0;
    font-weight: 500;
  }
  
  .hero-interests {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-2);
    margin: var(--spacing-2) 0;
  }
  
  .interest-tag {
    background: var(--color-surface-variant);
    color: var(--color-text-primary);
    padding: var(--spacing-1) var(--spacing-3);
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    font-weight: 500;
    border: 1px solid var(--color-border);
  }

  .hero-bio {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin: var(--spacing-4) 0;
    max-width: 65ch;
  }

  .hero-actions {
    display: flex;
    gap: var(--spacing-4);
    justify-content: center;
    margin-top: var(--spacing-2);
  }

  .hero-social {
    margin-top: var(--spacing-4);
    opacity: 0.8;
    transition: opacity var(--transition-base);
  }
  
  .hero-social:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--spacing-12) 0;
      min-height: auto;
    }

    .hero-title {
      font-size: var(--font-size-4xl);
    }

    .hero-image {
      width: 150px;
      height: 150px;
    }
    
    .hero-actions {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
    }
    
    .hero-actions :global(a) {
      width: 100%;
    }
  }
</style>
