---
import { profile } from '@data/profile';
import Button from '@components/UI/Button.astro';
import SocialLinks from '@components/UI/SocialLinks.astro';
---

<section class="hero" aria-labelledby="profile-name">
  <div class="container hero-content">
    <div class="hero-text">
      <p class="hero-subtitle">{profile.institution} · {profile.department}</p>
      <h1 id="profile-name">{profile.name}</h1>
      <p class="hero-role">{profile.title}</p>
      <p class="hero-bio">{profile.bio}</p>
      <div class="hero-interests" aria-label="Research interests">
        {profile.researchInterests.map((interest) => <span>{interest}</span>)}
      </div>
      {profile.availability && <p class="availability">{profile.availability}</p>}
      <p class="graduation">{profile.graduation}</p>
      <div class="hero-actions">
        {profile.cv && <Button href={profile.cv} variant="primary" external={true}>Download CV</Button>}
        <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>
      <SocialLinks />
    </div>
    {profile.avatar && <img class="portrait" src={profile.avatar} alt="Guorui Sang" width="224" height="280" fetchpriority="high" />}
  </div>
</section>

<style>
  .hero { padding: 4rem 0 3.5rem; }
  .hero-content { display: grid; grid-template-columns: minmax(0, 1fr) 224px; gap: 4rem; align-items: start; }
  .hero-subtitle { color: var(--color-text-secondary); font-size: .875rem; margin-bottom: 1rem; }
  h1 { font-size: clamp(2.5rem, 5vw, 3.5rem); margin-bottom: .75rem; }
  .hero-role { color: var(--color-text-primary); font-weight: 600; margin-bottom: 1.25rem; }
  .hero-bio { color: var(--color-text-secondary); max-width: 65ch; line-height: 1.8; }
  .hero-interests { display: flex; flex-wrap: wrap; gap: .5rem 1rem; margin: 1.25rem 0; color: var(--color-primary); font-size: .875rem; font-weight: 500; }
  .availability { font-weight: 600; border-left: 3px solid var(--color-primary); padding-left: .75rem; margin-top: 1.5rem; }
  .graduation { font-size: .875rem; color: var(--color-text-secondary); margin: .4rem 0 0 .95rem; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin: 1.5rem 0 1.25rem; }
  .email { text-underline-offset: 4px; }
  .portrait { width: 224px; height: 280px; object-fit: cover; border-radius: .5rem; margin-top: .3rem; }
  @media (max-width: 768px) {
    .hero { padding: 2.5rem 0; }
    .hero-content { grid-template-columns: 1fr; gap: 1.5rem; }
    .portrait { grid-row: 1; width: 104px; height: 130px; }
    .hero-subtitle { margin-bottom: .75rem; }
  }
</style>
